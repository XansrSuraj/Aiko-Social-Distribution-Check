# Copy to .env for local dev (dev-server.js reads it). Never commit the real .env — it is gitignored.
# On Vercel, set these as Project → Settings → Environment Variables instead.

# ── Shared storage (optional) ────────────────────────────────────────────────
# Without these the dashboard runs in local mode: the report stays in whichever
# browser ran the check. With them, the report is shared across every device.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service_role-key

# ── Push-in auth (needed once Viber or any /api/ingest push is used) ──────────
# A long random string. Sent by the pusher as the x-ingest-key header, a ?key=
# query param, or a "key" body field. Without it set, /api/ingest and /api/notif
# answer only to localhost.
INGEST_KEY=change-me-to-a-long-random-string

# ── Which Viber communities /api/notif watches (optional) ─────────────────────
# "Name=viber:handle" pairs, comma-separated. Defaults to the two SportsFC ones.
# VIBER_COMMUNITIES=Sportsfc.vn=viber:sportsfc.vn,Sportsfc.fans=viber:sportsfc.fans

# ── App-level gate on the report write (optional) ─────────────────────────────
# Only if you want /api/report writes to require x-admin-key on top of Vercel
# Deployment Protection. Leave unset for the no-login default.
# ADMIN_PASSWORD=
